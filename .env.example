# 이 파일을 복사해서 .env로 만들고 본인 값으로 채우세요 (.env는 git에 안 올라감)
# cp .env.example .env

# 로컬 PostgreSQL 계정이 기본값(postgres/postgres)과 다를 때만 채우면 됩니다
DB_USERNAME=
DB_PASSWORD=

# AI(Gemini) 기능을 로컬에서 실제로 호출/테스트할 때만 필요합니다
# 발급: https://aistudio.google.com/apikey
AI_API_KEY=

# 로컬 개발은 기본값(CHANGE_ME_LOCAL_ONLY_DO_NOT_USE_IN_PROD)으로 충분해서 보통은 안 채워도 됩니다
JWT_SECRET=
